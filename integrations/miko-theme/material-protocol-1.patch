+++ b/miko_theme/integration.py	2026-10-08 15:43:13.319726887 +0300
@@ -0,0 +1,78 @@
+"""Versioned, read-only inspection and serialized material operations for clients."""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import fcntl
+import json
+import re
+import subprocess
+
+from miko_theme.config import BASE_DIR, Config, list_modes, load_mode
+from miko_theme.adapters.base import ApplyContext
+from miko_theme.adapters.hyprland import HyprlandAdapter
+from miko_theme.backup import create_backup, latest_backup
+from miko_theme.utils import read_json, command_exists
+
+
+@contextmanager
+def execution_lock():
+    BASE_DIR.mkdir(parents=True, exist_ok=True)
+    with (BASE_DIR / "apply.lock").open("a") as handle:
+        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+        yield
+
+
+def live_blur() -> dict:
+    result = {}
+    if not command_exists("hyprctl"):
+        return result
+    for key in ("enabled", "size", "passes"):
+        try:
+            proc = subprocess.run(["hyprctl", "getoption", "decoration:blur:" + key, "-j"], capture_output=True, text=True, timeout=3)
+            value = json.loads(proc.stdout) if proc.returncode == 0 else {}
+            current = value.get("bool") if key == "enabled" else value.get("int")
+            if current is not None:
+                result[key] = bool(current) if key == "enabled" else int(current)
+        except (OSError, ValueError, subprocess.TimeoutExpired):
+            pass
+    return result
+
+
+def inspect_state(cfg: Config) -> dict:
+    path = cfg.paths.get("illogicalConfig")
+    current = read_json(path, {}) if path else {}
+    modes = []
+    for name in list_modes():
+        if not re.fullmatch(r"[a-zA-Z0-9_-]{1,64}", name):
+            continue
+        mode = load_mode(name)
+        modes.append({"id": name, "name": mode.get("name", name), "illogical": mode.get("illogical", {}), "blur": mode.get("hyprland", {}).get("set", {})})
+    blur = live_blur()
+    backup = latest_backup(cfg.paths["backups"]) if cfg.paths.get("backups") else None
+    return {"protocol": 1, "activeMode": cfg.active_mode, "modes": modes,
+        "enabledAdapters": cfg.enabled_adapters,
+        "transparency": current.get("appearance", {}).get("transparency", {}),
+        "blur": blur, "lastApply": cfg.raw.get("lastApply", {}),
+        "canRollback": bool(backup and (backup / "hypr-shell-overrides.lua").exists()),
+        "blurSupported": HyprlandAdapter(cfg).is_available() and len(blur) == 3}
+
+
+def apply_blur(enabled: bool, size: int, passes: int, expect: dict | None = None) -> int:
+    if not 1 <= size <= 16 or not 1 <= passes <= 4:
+        raise ValueError("Blur size must be 1..16 and passes 1..4")
+    with execution_lock():
+        cfg = Config.load()
+        if expect is not None and live_blur() != expect:
+            print("Blur changed externally. Refresh before applying.")
+            return 1
+        create_backup(cfg, reason="blur")
+        expected = {"enabled": enabled, "size": size, "passes": passes}
+        sets = {"decoration:blur:" + key: str(value).lower() for key, value in expected.items()}
+        adapter = HyprlandAdapter(cfg)
+        success, message = adapter.apply(ApplyContext(cfg, {"hyprland": {"set": sets}}, {}))
+        if success and live_blur() != expected:
+            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
+            if live_blur() != expected:
+                success, message = False, "Blur configuration saved, but live compositor values differ"
+        print(message)
+        return 0 if success else 1
